# ==============================================================================
# AUTONOMOUS LIVING: ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Use this file to set up your local .env. 
# NEVER commit the actual .env file with real secrets.

# --- SYSTEM SETTINGS ---
TZ=Europe/Warsaw
PUID=1000
PGID=1000
BASE_DIR=/home/michal/Documents/autonomous-living
OBSIDIAN_VAULT=../Obsidian Vault
MODULES_ENABLED=*
SHADOW_MODE=false

# --- TELEGRAM BOT ---
TELEGRAM_BOT_TOKEN=[BOT_TOKEN]
TELEGRAM_CHAT_ID=[CHAT_ID]

# --- DATABASE (POSTGRES) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=[DB_PASSWORD]
POSTGRES_DB=autonomous_base

# --- N8N SETTINGS ---
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
DB_USER_N8N=n8n_user
DB_PASSWORD_N8N=[N8N_DB_PASSWORD]

# --- DIGITAL TWIN API ---
DIGITAL_TWIN_PORT=5677
DIGITAL_TWIN_API_KEY=[API_KEY_FOR_AGENTS]

# --- RABBITMQ (EDA) ---
RABBITMQ_USER=admin
RABBITMQ_PASS=[MQ_PASSWORD]

# --- EXTERNAL APIS ---
# Google Cloud
GOOGLE_CLIENT_ID=[GOOGLE_ID]
GOOGLE_CLIENT_SECRET=[GOOGLE_SECRET]

# Health / Biometrics
ZEPP_EMAIL=[ZEPP_EMAIL]
ZEPP_PASSWORD=[ZEPP_PASS]
WITHINGS_CLIENT_ID=[WITHINGS_ID]
WITHINGS_CLIENT_SECRET=[WITHINGS_SECRET]

# --- AI MODELS ---
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=[OPENAI_KEY] # Optional fallback

# --- MONITORING ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003
GRAFANA_PASSWORD=[GRAFANA_PASS]
